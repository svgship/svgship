# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# omc
.omc/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# accidentally nested workspace directory
/hermes-workspace/

# design references (not source code)
SVGShip.html
exported_image_optimized.svg
# 必须以 / 锚定根目录：写成 `logo.png` 会连带忽略 public/logo.png，
# 导致站点品牌 logo（Organization.logo 用的那张 256×256 位图）从未被提交和部署。
/logo.png
.gstack/
